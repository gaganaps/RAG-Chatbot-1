# ==============================================================================
# Mutual Fund FAQ Assistant - Environment Configuration
# Copy this file to .env and populate your active credentials and settings.
# ==============================================================================

# Free LLM Provider Configuration (Groq or Gemini)
# Obtain free Groq API key at: https://console.groq.com
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_MODEL=llama-3.1-8b-instant

# Optional Secondary Provider: Google Gemini (Free at: https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Embeddings & Vector Storage
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=hdfc_mutual_funds

# Ingestion & Daily Scheduler Settings (Default: 10:00 AM IST)
SCHEDULER_HOUR=10
SCHEDULER_MINUTE=0
SCHEDULER_TIMEZONE=Asia/Kolkata
DATA_RAW_DIR=./data/raw
DATA_PROCESSED_DIR=./data/processed

# Application Guardrail Settings
MAX_RESPONSE_SENTENCES=3
SIMILARITY_CONFIDENCE_THRESHOLD=0.65
MANDATORY_DISCLAIMER="Facts-only. No investment advice."
